      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "script",
        "debugSettings": {
          "failuresEnabled": false,
          "allEnabled": false,
          "allEnabledUntil": 1788373677791
        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "var soil = parseFloat(msg.soil_moisture);\r\nvar gas = parseFloat(msg.gas_ppm);\r\n\r\nvar status = 'healthy';\r\nvar action = 'none';\r\nvar hoursToCritical = null;\r\n\r\n// قراءة القيمة السابقة بأمان دون التسبب في إيقاف السكريبت\r\nvar prevSoil = null;\r\nif (metadata && metadata.ss_prev_soil_moisture && metadata.ss_prev_soil_moisture !== 'undefined') {\r\n    var parsed = parseFloat(metadata.ss_prev_soil_moisture);\r\n    if (!isNaN(parsed)) {\r\n        prevSoil = parsed;\r\n    }\r\n}\r\n\r\n// حساب الاتجاه والتنبؤ عند توفر القيمة السابقة فقط\r\nif (!isNaN(soil) && prevSoil !== null) {\r\n    var dropRate = prevSoil - soil;\r\n    if (dropRate > 0) {\r\n        var distanceToCritical = soil - 20;\r\n        if (distanceToCritical > 0) {\r\n            hoursToCritical = parseFloat((distanceToCritical / dropRate).toFixed(1));\r\n        } else {\r\n            hoursToCritical = 0;\r\n        }\r\n    }\r\n}\r\n\r\n// تحديث الحالة والعمليات المطلوب تنفيذها\r\nif (!isNaN(soil)) {\r\n    if (soil < 20) {\r\n        status = 'critical';\r\n        action = 'irrigate_now';\r\n    } else if (soil < 35 || (hoursToCritical !== null && hoursToCritical < 2)) {\r\n        status = 'at_risk';\r\n        action = 'irrigate_soon';\r\n    }\r\n}\r\n\r\nif (!isNaN(gas) && gas > 300) {\r\n    status = 'critical';\r\n    action = 'ventilate_or_check';\r\n}\r\n\r\n// حفظ القيمة الحالية للمرة القادمة\r\nif (!isNaN(soil)) {\r\n    metadata.ss_prev_soil_moisture = soil.toString();\r\n}\r\n\r\n// إسناد البيانات للرسالة\r\nmsg.status = status;\r\nmsg.action = action;\r\nif (hoursToCritical !== null) {\r\n    msg.hours_to_critical = hoursToCritical;\r\n}\r\n\r\nreturn {\r\n    msg: msg,\r\n    metadata: metadata,\r\n    msgType: msgType\r\n};",
          "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
          "description": "",
          "layoutX": 127,
          "layoutY": 475
        }
