        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "// التثبت من وجود متغيرات الحالة والأمر داخل الرسالة\r\nif (msg && (msg.status === 'critical' || msg.status === 'at_risk' || msg.action === 'irrigate_now')) {\r\n    return true; // يمر إلى مسار True -> Create Alarm\r\n}\r\n\r\nreturn false; // يمر إلى مسار False -> Clear Alarm",
